{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      "#build/ui/*": ["./.nuxt/ui/*"],
      "#build/app.config": ["./src/shims/app-config.ts"],
      "#imports": ["./src/shims/imports.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "build.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "playgrounds"
  ]
}
